# 이 파일을 복사해 beautyagent/site/.env 로 만들고 값을 넣어요. beautyagent/site/.env 는 커밋되지 않아요.
# 네이버 개발자센터(developers.naver.com) > Application 등록 > 사용 API: '데이터랩(검색어트렌드)' + '검색'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택: 수집 간격과 주소
# NEWS_EVERY_SEC=4
# NAVER_NEWS_EVERY_SEC=8
# DATALAB_EVERY_MIN=15
# PORT=8790
# HOST=0.0.0.0   (같은 와이파이의 팀원도 열 수 있게)
